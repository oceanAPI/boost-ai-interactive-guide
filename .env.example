# Auth.js v5 — Google sign-in gating /admin.
# Copy to .env.local (gitignored) and fill in for local dev.
# In production these are set in the Vercel dashboard.

# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → Credentials).
# Authorized redirect URIs to register on the client:
#   http://localhost:3000/api/auth/callback/google      (dev)
#   https://<your-project>.vercel.app/api/auth/callback/google  (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated external emails allowed past the @boost.ai gate.
# Leave blank for boost.ai-only access.
ALLOWED_EXTERNAL_EMAILS=

# --- Existing feedback / telemetry vars (carried over from GH Actions) ---
# Cloudflare Worker endpoint; blank => localStorage-only feedback mode.
NEXT_PUBLIC_FEED_API_URL=
NEXT_PUBLIC_FEED_CLIENT_TOKEN=
# Optional Export API proxy for the live-demo Analyze button.
NEXT_PUBLIC_BOOST_EXPORT_URL=
