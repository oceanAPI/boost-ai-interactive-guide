# Feed me log — shared backend for feedback + search log.
# Leave blank to use localStorage-only (per-browser).
#
# After deploying the Cloudflare worker (see cloudflare-worker/README.md),
# fill these in and copy this file to .env.local for local dev, or paste
# them into the GitHub Actions build env (repo Settings → Secrets and
# variables → Actions → New variable) for production.

NEXT_PUBLIC_FEED_API_URL=
NEXT_PUBLIC_FEED_CLIENT_TOKEN=
